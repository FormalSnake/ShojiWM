#!/usr/bin/env python3
"""shoji-ipc <method> [<params-json>] [--socket PATH] [--listen SECONDS]

Sends one request to a ShojiWM JSON IPC socket (newline-delimited JSON, the
wire format of shoji_wm/ipc) and prints the answer. --listen prints every
broadcast for that many seconds instead of waiting for one answer. The socket
defaults to $SHOJI_IPC_SOCKET, then $SHOJIWM_IPC_SOCKET.
"""
import json, os, socket, sys, time

args = sys.argv[1:]
sock_path = os.environ.get("SHOJI_IPC_SOCKET") or os.environ.get("SHOJIWM_IPC_SOCKET")
listen = None
if "--socket" in args:
    i = args.index("--socket"); sock_path = args[i + 1]; del args[i:i + 2]
if "--listen" in args:
    i = args.index("--listen"); listen = float(args[i + 1]); del args[i:i + 2]
if not args or not sock_path:
    sys.exit(__doc__)
request = {"id": 1, "method": args[0]}
if len(args) > 1:
    request["params"] = json.loads(args[1])

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)
s.sendall((json.dumps(request) + "\n").encode())
deadline = time.time() + (listen if listen is not None else 10)
buf = b""
while time.time() < deadline:
    s.settimeout(max(0.01, deadline - time.time()))
    try:
        chunk = s.recv(65536)
    except socket.timeout:
        break
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        message = json.loads(line)
        if listen is not None:
            print(json.dumps(message), flush=True)
        elif message.get("id") == 1:
            if "error" in message:
                print(message["error"], file=sys.stderr)
                sys.exit(1)
            print(json.dumps(message.get("result")))
            sys.exit(0)
if listen is None:
    sys.exit("shoji-ipc: no answer within 10 s")
