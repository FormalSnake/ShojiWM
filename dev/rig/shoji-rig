#!/usr/bin/env python3
"""shoji-rig <command...>

Runs <command> on fstest3@fstestmac over ssh while holding the macbook's
/tmp/formalshell-mac-3.lock, the lock FormalShell's dev/remote.sh takes
before it starts Hyprland on slot 3. Without it a FormalShell run can take
the card in the middle of a ShojiWM session, or the other way round.

    shoji-rig '~/shoji-run.sh ~/my-config -- ~/check.sh'

SHOJI_RIG_HOST overrides the ssh target, SHOJI_RIG_LOCK the lock file.
"""
import fcntl
import os
import subprocess
import sys
import time

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    sys.stderr.write(__doc__)
    sys.exit(2)

path = os.environ.get("SHOJI_RIG_LOCK", "/tmp/formalshell-mac-3.lock")
host = os.environ.get("SHOJI_RIG_HOST", "fstest3@fstestmac")
lock = open(path, "a")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.stderr.write("shoji-rig: waiting for %s (a FormalShell run holds slot 3)\n" % path)
    began = time.time()
    fcntl.flock(lock, fcntl.LOCK_EX)
    sys.stderr.write("shoji-rig: got the slot after %ds\n" % (time.time() - began))

sys.exit(subprocess.call(["ssh", host, " ".join(sys.argv[1:])]))
