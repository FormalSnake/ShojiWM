{
  "name": "shoji-wm-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/shoji_wm/tsconfig.json && tsc -p packages/config/tsconfig.json",
    "test:overlays": "node --import tsx --test tests/output-overlay.test.ts && tsc -p tests/tsconfig.overlays.json",
    "test:output-power": "node --import tsx --test tests/output-power.test.ts",
    "test:headless-output": "node --import tsx --test tests/headless-output.test.ts",
    "test:output-vrr": "node --import tsx --test tests/output-vrr.test.ts",
    "test:clear-color": "node --import tsx --test tests/clear-color.test.ts",
    "test:output-direct-scanout": "node --import tsx --test tests/output-direct-scanout.test.ts",
    "test:output-auto-hdr": "node --import tsx --test tests/output-auto-hdr.test.ts",
    "test:session-is-locked": "node --import tsx --test tests/session-is-locked.test.ts",
    "test:cursor-transform": "node --import tsx --test tests/cursor-transform.test.ts",
    "test:key-is-repeat": "node --import tsx --test tests/key-is-repeat.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
